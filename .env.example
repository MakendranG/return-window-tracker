# -----------------------------------------------------------------------------
# Return Window Tracker — environment configuration EXAMPLE
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# No secrets are hardcoded anywhere in the code — everything is read from the
# environment at runtime.
#
# By default this project uses the Strands Agents SDK default model provider,
# Amazon Bedrock (Claude Sonnet). Provide AWS credentials with permission to
# invoke the model.

# --- Option A: standard AWS credentials ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token        # only if using temporary creds
AWS_REGION=us-west-2

# --- Option B: Amazon Bedrock API key (alternative to the keys above) ---
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# --- Optional: override the model the agent uses ---
# STRANDS_MODEL_ID=global.anthropic.claude-sonnet-4-6
